{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Effect": "Allow",
      "Action": ["s3:GetObject", "s3:PutObject"],
      "Resource": [
        "arn:aws:s3:::travel-inspo-photos-377281019881/originals/*",
        "arn:aws:s3:::travel-inspo-photos-377281019881/thumbnails/*"
      ]
    },
    {
      "Effect": "Allow",
      "Action": ["dynamodb:PutItem", "dynamodb:Query"],
      "Resource": "arn:aws:dynamodb:us-east-1:377281019881:table/likes"
    }
  ]
}
